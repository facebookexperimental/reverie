load("@bazel_skylib//lib:paths.bzl", "paths")
load("@fbcode//hermetic_infra/reverie/fb-only:defs.bzl", "gated_test", "run_gated_only")
load("@fbcode_macros//build_defs:cpp_binary.bzl", "cpp_binary")
load("@fbcode_macros//build_defs:custom_rule.bzl", "custom_rule")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_binary", "buck_sh_test")
load("@fbcode_macros//build_defs:sanitizers.bzl", "sanitizers")
load("@fbsource//tools/build_defs:glob_defs.bzl", "subdir_glob")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_unittest.bzl", "rust_unittest")
load("@fbsource//tools/build_defs:selects.bzl", "selects")

oncall("hermit")

# Some tests don't work when a sanitizer is in use (i.e., with @mode/dev). This
# makes it easy to conditionally compile them with `#[cfg(not(sanitized))]`.
sanitized_feature = selects.apply(
    sanitizers.get_sanitizer_v2(),
    lambda san: ["--cfg=sanitized"] if san else [],
)

# Reverie's generic conformance tests (upstream's generic-* targets): each runs
# a Rust command guest built below, through reverie-test-support.
CONFORMANCE_TESTS = [
    "at_random.rs",
    "basics.rs",
    "exit.rs",
    "initial_stack_pointer.rs",
    "inject_then_tail.rs",
    "stack.rs",
    "stat.rs",
    "suppression.rs",
    "thread_start.rs",
    "vdso.rs",
]

# Tests whose tools subscribe to CPUID, which Reverie's ptrace backend can
# intercept only on a host with CPUID faulting.
GATED_TESTS = ["cpuid.rs", "timer_semantics.rs"]

[
    rust_unittest(
        name = paths.replace_extension(test, ""),
        srcs = [test],
        # timer_semantics and cpuid run through gated tests below (fb-only/gated_tests).
        labels = run_gated_only() if test in GATED_TESTS else [],
        rustc_flags = sanitized_feature,
        deps = [
            "fbsource//third-party/rust:close-err",
            "fbsource//third-party/rust:futures",
            "fbsource//third-party/rust:libc",
            "fbsource//third-party/rust:nix",
            "fbsource//third-party/rust:raw-cpuid",
            "fbsource//third-party/rust:serde",
            "fbsource//third-party/rust:syscalls",
            "fbsource//third-party/rust:test-case",
            "fbsource//third-party/rust:tokio",
            "//hermetic_infra/reverie:reverie",
            "//hermetic_infra/reverie:reverie-ptrace",
            "//hermetic_infra/reverie:reverie-util",
        ],
    )
    # first_instruction_cpuid.rs compiles its guests with rustc at test time,
    # which Buck tests don't have; Cargo runs it upstream.
    for test in glob(
        ["*.rs"],
        exclude = ["first_instruction_cpuid.rs"] + CONFORMANCE_TESTS,
    )
]

[
    gated_test(
        name = paths.replace_extension(test, "") + "-gated",
        test = "//hermetic_infra/reverie/tests:" + paths.replace_extension(test, ""),
    )
    for test in GATED_TESTS
]

# Command guests and conformance tests, as upstream declares them. The guests
# use the system allocator, as their Cargo builds do: fbcode's default jemalloc
# starts a background thread before main, which the thread-start tail test
# cannot survive (https://github.com/rrnewton/reverie/issues/1402).
rust_binary(
    name = "basics-rust-command-guest",
    srcs = [
        "fixtures/basics-rust-command.rs",
        "support/basics_rust_guest.rs",
    ],
    allocator = "malloc",
    crate_root = "fixtures/basics-rust-command.rs",
    unittests = False,
    deps = [
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
    ],
)

rust_binary(
    name = "exit-rust-command-guest",
    srcs = [
        "fixtures/exit-rust-command.rs",
        "support/exit_rust_guest.rs",
    ],
    allocator = "malloc",
    crate_root = "fixtures/exit-rust-command.rs",
    # The guest ends with an x86-64 `ud2`.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    unittests = False,
    deps = [
        "fbsource//third-party/rust:libc",
    ],
)

rust_binary(
    name = "stat-rust-command-guest",
    srcs = [
        "fixtures/stat-rust-command.rs",
