rust_unittest(
    name = "basics",
    srcs = [
        "basics.rs",
        "support/basics_commands.rs",
        "support/basics_rust_guest.rs",
        "tool_fixtures/basics.rs",
    ],
    crate_root = "basics.rs",
    env = {
        "CARGO_BIN_EXE_basics-rust-command-guest": "$(location :basics-rust-command-guest)",
    },
    features = ["nightly"],
    resources = [":basics-rust-command-guest"],
    # The compile-time path above is where rustc ran (possibly a remote
    # worker); the test reads this one first (reverie-test-support guest_binary!).
    run_env = {
        "CARGO_BIN_EXE_basics-rust-command-guest": "$(location :basics-rust-command-guest)",
    },
    rustc_flags = sanitized_feature,
    deps = [
        "fbsource//third-party/rust:close-err",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:serde",
        "//hermetic_infra/reverie:reverie",
        "//hermetic_infra/reverie:reverie-ptrace",
        "//hermetic_infra/reverie:reverie-test-support",
    ],
)

