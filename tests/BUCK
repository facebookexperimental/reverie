# Everything in the c_tests folder is an active test. To disable a test, delete
# it or move it to the `disabled/` directory.
reverie_tests = [
    paths.replace_extension(
        paths.basename(p),
        "",
    )
    for p in glob(["c_tests/*.c"])
]

# These are assembly files without any external deps (nostdlib)
reverie_standalone_tests = [
    paths.replace_extension(
        paths.basename(p),
        "",
    )
    for p in glob(["c_tests/*.S"])
]

# call cc to build with `-nostdlib` flag
# FIXME(T77896624): This is currently broken!
buck_sh_binary(
    name = "cc_no_shlib",
    main = "c_tests/cc_no_shlib.sh",
)

# build tests from assembly without shlib
[
    custom_rule(
        name = "test_binary_" + base,
        srcs = ["c_tests/" + base + ".S"],
        build_args = "c_tests/" + base + ".S",
        build_script_dep = ":cc_no_shlib",
        has_content_based_path = False,
        output_gen_files = [
            base,
        ],
    )
    for base in reverie_standalone_tests
]

# Run natively without instrumentation:
[
    cpp_binary(
        name = "test_" + base,
        srcs = ["c_tests/" + base + ".c"],
        headers = subdir_glob([
            ("c_tests/", "*.h"),
        ]),
        allocator = "malloc",
        compiler_flags = [
            "-g",
            "-Wall",
            "-O2",
            "-D_POSIX_C_SOURCE=20180920",
            "-D_GNU_SOURCE=1",
            "-fPIC",
        ],
    )
    for base in reverie_tests
]

# The reverie-examples tools (noop, strace, counter1/2, chunky_print) are not
# built in fbsource since the 0.5 import: upstream's shared examples backend
# links the DynamoRIO and e9patch backends, whose vendored trees fbsource
# excludes from its import.

buck_sh_test(
    name = "sh-test-at-random",
    args = [],
    test = ":at-random",
    deps = [
        ":at-random",
    ],
)

# Run tests without any sort of syscall interception.
[
    buck_sh_test(
        name = "run_" + base,
        args = [],
        test = ":test_" + base,
    )
    for base in reverie_tests
]
